<pdd-reason>The single process the ElevenLabs widget talks to. Read and write paths must stay in the tens of milliseconds because a human is waiting mid-sentence.</pdd-reason>
<pdd-interface>{"type": "api"}</pdd-interface>
<pdd-dependency>contract_Python.prompt</pdd-dependency>
<pdd-dependency>security_Python.prompt</pdd-dependency>
<pdd-dependency>form_registry_Python.prompt</pdd-dependency>
<pdd-dependency>session_store_Python.prompt</pdd-dependency>
