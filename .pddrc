version: "1.0"

contexts:
  default:
    defaults:
      prompts_dir: "prompts"
      generate_output_path: "api/"
      test_output_path: "tests/"
      example_output_path: "context/"
      default_language: "python"
      strength: 0.818
      temperature: 0.0
      target_coverage: 80.0
      budget: 10.0
      max_attempts: 3

  # Scripted call drivers live outside the served package.
  mocks:
    paths: ["mock_*"]
    defaults:
      prompts_dir: "prompts"
      generate_output_path: "mocks/"
      test_output_path: "tests/"
      default_language: "python"
