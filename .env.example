# Copy to .env and fill in. NEVER commit .env.
#
# Nothing here is required to start the service. Every lane degrades to
# something that still works, and /health reports which lane you are actually
# on -- so a missing key is a visible downgrade, never a silent one.

# Shared secret sent by the ElevenLabs agent as header `X-Zuzu-Secret`
# on every webhook and server-tool call. Must match the value in the
# ElevenLabs agent config.
ZUZU_SHARED_SECRET=changeme

# Layer 1 = in-memory (single process, demo-safe). Layer 2 = redis.
# With `memory`, run exactly ONE worker: session state is in-process.
STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Public base URL the ElevenLabs agent calls (ngrok / Render URL in prod)
PUBLIC_BASE_URL=http://localhost:8000

# --- Voice ------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- What the agents think with ---------------------------------------------
# MiniMax-M3 through TokenRouter, an OpenAI-compatible gateway. Unset, the six
# agents still run -- on the deterministic fallback, which keeps the fixed
# hand-off order and loses the judgement. The audit trail labels every turn
# with which of the two decided it, so the difference is never hidden.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=MiniMax-M3

# Same lane, other providers. First key set wins, in this order.
# NOTE: model ids are account-specific -- check `GET /v1/models` first.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=zai-glm-4.7
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Band: the room the agents talk in --------------------------------------
# BAND_USER_API_KEY is the account key, used ONCE to register the fleet:
#
#     uv run python tools/register_band_agents.py
#
# That writes one per-agent key per role to BAND_CREDENTIALS_PATH (mode 0600,
# gitignored) -- Band shows an agent's key exactly once, so losing the file
# means re-registering under new names. Which is why the namespace exists: Band
# agent names are unique per account and it refuses to delete an agent that has
# execution history, so a name, once used, is used forever.
#
# With no credentials the fleet starts empty and /sessions/{id}/orchestrate
# answers 503 rather than pretending.
BAND_USER_API_KEY=
BAND_FLEET_NAMESPACE=
BAND_CREDENTIALS_PATH=.band-agents.json

# Anywhere the disk is ephemeral, pass the same per-agent credentials as env
# vars instead of a file. These win over the file when all six pairs are set;
# a partial set falls back to it. One pair per role:
# BAND_AGENT_INTAKE_ID / BAND_AGENT_INTAKE_KEY, then EXTRACTOR, MAPPER,
# VALIDATOR, FILLER, AUDITOR.

# --- Memory: what Zuzu remembers about a caller between calls ----------------
# Unset, memory is SQLite: no credentials, durable on disk, and gone on the
# next deploy anywhere the disk is ephemeral (Render's is). Set both and it
# moves to Supabase and survives. See docs/supabase-setup.md.
#
# Use the service_role key (`sb_secret_...`), NOT the publishable one: the
# table has RLS on with no anon policy, so the publishable key reads an empty
# list and writes 401 -- which looks exactly like "the applicant is new".
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Where SQLite lives when Supabase is not configured.
ZUZU_MEMORY_DB=data/memory.db
# Whether identifiers (A-number, SSN, passport) may be persisted at all.
ZUZU_MEMORY_STORE_SENSITIVE=false

# --- Multi-tenant ------------------------------------------------------------
# A JSON registry of organisations; only SHA-256 hashes of keys are stored, so
# this file cannot be read back into a working key. Mint one with:
#
#     uv run python tools/add_tenant.py --id clinic-a --name "Clinic A"
#
# Unset means single-tenant: every caller is the default tenant and the
# X-Zuzu-Tenant-Key header is optional. Set it and the header is required --
# with more than one organisation, "whose session is this" has a real answer.
#
# Takes either the JSON itself (which is how it is set on Render, where there
# is no file to point at) or a path to a file holding it.
#
# LEAVE THIS EMPTY unless you have actually created a registry. data/tenants.json
# is gitignored, so it does not exist in a fresh clone -- and pointing at a file
# that is not there is a hard error, not a fallback, which turned every endpoint
# into a 401 for anyone who copied this file and ran the service.
ZUZU_TENANTS_JSON=
ZUZU_DEFAULT_TENANT=default
ZUZU_DEFAULT_TENANT_NAME=Default
# Used by the tools and the dashboard to authenticate as one tenant.
ZUZU_TENANT_KEY=

# --- Optional: DOM agent fills the live USCIS form to the review step. -------
# Human approves; never auto-submit. Also fetches uscis.gov, which refuses
# httpx on TLS fingerprint regardless of user agent.
RTRVR_API_KEY=

# --- Deploy ------------------------------------------------------------------
RENDER_API_KEY=
