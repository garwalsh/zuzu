# Copy to .env and fill in. NEVER commit .env.

# Shared secret sent by the ElevenLabs agent as header `X-Zuzu-Secret`
# on every webhook and server-tool call. Must match the value in the
# ElevenLabs agent config.
ZUZU_SHARED_SECRET=changeme

# Layer 1 = in-memory (single process, demo-safe). Layer 2 = redis.
# With `memory`, run exactly ONE worker: session state is in-process.
STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Public base URL the ElevenLabs agent calls (ngrok / Render URL in prod)
PUBLIC_BASE_URL=http://localhost:8000

# --- Speed lane: low-latency next-question + parallel field mapping ---
# NOTE: model ids here are account-specific. Check `GET /v1/models` before
# setting this -- `llama-3.3-70b` is NOT available and returns 404.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=zai-glm-4.7

# --- Cross-session applicant memory, keyed by caller id ---
MEM0_API_KEY=

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Capability lane: multimodal document intake + long-context parsing ---
# OpenAI-compatible gateway.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# --- Deploy ---
RENDER_API_KEY=

# --- Optional auto-file path: DOM agent fills the live USCIS form to the
# review step. Human approves; never auto-submit. ---
RTRVR_API_KEY=

# --- memory store -----------------------------------------------------------
# Unset, Zuzu uses SQLite: no credentials, durable within a deploy, lost on
# redeploy because Render's disk is ephemeral. Set both of these and memory
# moves to Supabase and survives. See docs/supabase-setup.md.
# Use the service_role key, not anon: the table denies anon by design.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
