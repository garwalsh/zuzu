# Copy to .env and fill in. NEVER commit .env.

# Shared secret sent by the ElevenLabs agent as header `X-Zuzu-Secret`
# on every webhook and server-tool call. Must match the value in the
# ElevenLabs agent config.
ZUZU_SHARED_SECRET=changeme

# Layer 1 = in-memory (single process, demo-safe). Layer 2 = redis.
STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Cerebras: fast inference for next-question reasoning + parallel field mapping
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# mem0: cross-session applicant memory keyed by caller id
MEM0_API_KEY=

# Public base URL the ElevenLabs agent calls (ngrok / Render URL in prod)
PUBLIC_BASE_URL=http://localhost:8000
